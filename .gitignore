.env
.env.*
!.env.example
.venv/
.diracdata/
v1/
/data/
/artifacts/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.DS_Store

# Local generated datasets and database files. Rebuild with scripts.
**/parquet/
*.duckdb
*.db
v2/data/fintech_schema/
v2/data/retail_analytics/
v2/data/tpcds/

# Local UAT/model traces can be large and may include provider output.
**/data/uat_runs/
**/tmp_model_runs*/
v2/models/

# Build/test packaging output.
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

# Runtime-generated agent artifacts (experiences, value cache, learned joins) -- the harness
# rebuilds these as it runs; they are per-run state, not source.
v3/experience/*
!v3/experience/.gitkeep

# Generated context artifacts (regenerate with v2/scripts/*).
v2/learning/

# Large retrieval-training / benchmark eval packs -- not used by the v3 harness.
v2/evals/retail_column_retrieval_pairs_*.csv
v2/evals/Benchmark_*.csv
v2/evals/retail_schema_aware_benchmark.csv

# Local editor / agent config and scratch.
.claude/
*.log
tmp/
scratch/
