ld/fintech_nl_sql_pairs.csv", "source_template": "", "template_variant": "", "type": "gold_nl_sql"}}
{"case_id": "fin_gold_019", "category": "psr", "difficulty": "medium", "expected_ambiguities": [], "expected_columns": [], "expected_join_edges": ["payments.rail_ref = payment_attributes.rail_ref"], "expected_output": "{\"columns\": [\"rail_type\", \"psr\", \"attempts\"], \"comparison_mode\": \"ordered_rows\", \"preview_row_count\": 2, \"result_hash\": \"7617c571b51ac41e1ad85bba9ba19f6c79f1f553603dddf676951fafdbfd7db1\", \"row_count\": 2, \"rows\": [[\"CC\", 0.7959183673469388, 2597], [\"DC\", 0.7681564245810056, 1790]], \"scalar\": null, \"truncated\": false}", "expected_result": {"columns": ["rail_type", "psr", "attempts"], "comparison_mode": "ordered_rows", "preview_row_count": 2, "result_hash": "7617c571b51ac41e1ad85bba9ba19f6c79f1f553603dddf676951fafdbfd7db1", "row_count": 2, "rows": [["CC", 0.7959183673469388, 2597], ["DC", 0.7681564245810056, 1790]], "scalar": null, "truncated": false}, "expected_sql": "SELECT pa.rail_type, SUM(CASE WHEN p.payment_status = 'SUCCESS' THEN 1 ELSE 0 END)::DOUBLE / COUNT(*) AS psr, COUNT(*) AS attempts FROM payments p JOIN payment_attributes pa ON p.rail_ref = pa.rail_ref WHERE pa.authentication_mode = 'otp_or_3ds' AND pa.rail_type IN ('CC', 'DC') AND p.payment_time >= '2026-01-01' GROUP BY pa.rail_type ORDER BY pa.rail_type", "expected_tables": [], "question": "Compare payment success rate for OTP or 3DS authentication across credit and debit card rails since 2026-01-01.", "schema": "fintech_schema", "source": {"notes": "Card rails use rail_type CC and DC.", "path": "v2/data/gold/fintech_nl_sql_pairs.csv", "source_template": "", "template_variant": "", "type": "gold_nl_sql"}}
{"case_id": "fin_gold_020", "category": "cohort", "difficulty": "hard", "expected_ambiguities": [], "expected_columns": [], "expected_join_edges": ["payments.user_ref = user_attributes.user_ref"], "expected_output": "{\"columns\": [\"risk_band\", \"kyc_status\", \"users\"], \"comparison_mode\": \"ordered_rows\", \"preview_row_count\": 5, \"result_hash\": \"98b2d3b1f23c82ff1bfd1986ecc34943c36e3a0d448ea126e3c92e6c0ead6fc2\", \"row_count\": 5, \"rows\": [[\"high\", \"pending\", 1], [\"high\", \"verified\", 5], [\"low\", \"pending\", 1], [\"low\", \"verified\", 20], [\"medium\", \"verified\", 5]], \"scalar\": null, \"truncated\": false}", "expected_result": {"columns": ["risk_band", "kyc_status", "users"], "comparison_mode": "ordered_rows", "preview_row_count": 5, "result_hash": "98b2d3b1f23c82ff1bfd1986ecc34943c36e3a0d448ea126e3c92e6c0ead6fc2", "row_count": 5, "rows": [["high", "pending", 1], ["high", "verified", 5], ["low", "pending", 1], ["low", "verified", 20], ["medium", "verified", 5]], "scalar": null, "truncated": false}, "expected_sql": "WITH may_users AS (SELECT DISTINCT p.user_ref FROM payments p JOIN user_attributes ua ON p.user_ref = ua.user_ref WHERE p.payment_status = 'SUCCESS' AND p.payment_time >= '2026-05-01' AND p.payment_time < '2026-06-01' AND ua.state = 'Gujarat'), april_users AS (SELECT DISTINCT p.user_ref FROM payments p JOIN user_attributes ua ON p.user_ref = ua.user_ref WHERE p.payment_status = 'SUCCESS' AND p.payment_time >= '2026-04-01' AND p.payment_time < '2026-05-01' AND ua.state = 'Gujarat') SELECT ua.risk_band, ua.kyc_status, COUNT(DISTINCT m.user_ref) AS users FROM may_users m JOIN user_attributes ua ON m.user_ref = ua.user_ref WHERE NOT EXISTS (SELECT 1 FROM april_users a WHERE a.user_ref = m.user_ref) GROUP BY ua.risk_band, ua.kyc_status ORDER BY ua.risk_band, ua.kyc_status", "expected_tables": [], "question": "Find users in Gujarat who had successful payments in May 2026 but no successful payments in April 2026, split by risk band and KYC status.", "schema": "fintech_schema", "source": {"notes": "Negative cohort uses the same successful-payment action in both months.", "path": "v2/data/gold/fintech_nl_sql_pairs.csv", "source_template": "", "template_variant": "", "type": "gold_nl_sql"}}
